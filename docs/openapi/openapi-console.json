{
  "openapi": "3.0.3",
  "info": {
    "title": "NewsFlow CONSOLE 接口文档",
    "description": "NewsFlow CONSOLE 的接口定义，对应 docs/接口设计文档.md 的 CONSOLE 部分。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "NEWSFLOW CONSOLE"
    }
  ],
  "tags": [
    {
      "name": "console",
      "description": "NEWSFLOW CONSOLE，端口 8081"
    }
  ],
  "paths": {
    "/article/create": {
      "servers": [
        {
          "url": "http://localhost:8081"
        }
      ],
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章新增",
        "operationId": "articleCreate",
        "parameters": [
          {
            "name": "coverImages",
            "in": "query",
            "required": true,
            "description": "轮播图，多张用 $ 拼接",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "标题",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "作者",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "正文",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishTime",
            "in": "query",
            "required": true,
            "description": "发布时间，格式 yyyy-MM-dd",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-29"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功 or 失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    },
    "/article/update": {
      "servers": [
        {
          "url": "http://localhost:8081"
        }
      ],
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章修改",
        "operationId": "articleUpdate",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "coverImages",
            "in": "query",
            "required": true,
            "description": "轮播图，多张用 $ 拼接",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "标题",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "作者",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "正文",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishTime",
            "in": "query",
            "required": true,
            "description": "发布时间，格式 yyyy-MM-dd",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-29"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「成功」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    },
    "/article/delete": {
      "servers": [
        {
          "url": "http://localhost:8081"
        }
      ],
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章删除",
        "operationId": "articleDelete",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「成功」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    }
  }
}
