{
  "openapi": "3.0.3",
  "info": {
    "title": "NewsFlow CONSOLE 接口文档",
    "description": "NewsFlow CONSOLE 的接口定义，对应 docs/接口设计文档.md 的 CONSOLE 部分。",
    "version": "2.2.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "NEWSFLOW CONSOLE"
    }
  ],
  "tags": [
    {
      "name": "console",
      "description": "NEWSFLOW CONSOLE，端口 8081"
    }
  ],
  "paths": {
    "/article/list": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章列表",
        "operationId": "consoleArticleList",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "description": "页码，从 1 开始",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "标题关键词，非必传",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，时间字段格式为 yyyy-MM-dd HH:mm:ss",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleArticleListVo"
                },
                "example": {
                  "list": [
                    {
                      "articleId": 30,
                      "wallImage": "https://a.com/1.jpg",
                      "title": "示例标题",
                      "categoryName": "清洁能源",
                      "publishTime": "2026-10-03 06:00:00",
                      "createTime": "2026-10-03 05:00:00",
                      "updateTime": "2026-10-03 05:00:00"
                    }
                  ],
                  "total": 30,
                  "pageSize": 10
                }
              }
            }
          }
        }
      }
    },
    "/article/info": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章详情",
        "operationId": "consoleArticleInfo",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，时间字段格式为 yyyy-MM-dd HH:mm:ss",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleArticleInfoVo"
                },
                "example": {
                  "articleId": 1,
                  "coverImages": [
                    "https://a.com/1.jpg",
                    "https://a.com/2.jpg"
                  ],
                  "title": "示例标题",
                  "author": "示例作者",
                  "content": "示例正文",
                  "publishTime": "2026-10-29 20:00:00",
                  "createTime": "2026-10-29 19:00:00",
                  "updateTime": "2026-10-29 19:00:00",
                  "categoryId": 1,
                  "categoryName": "清洁能源",
                  "categoryImage": "https://a.com/category-1.jpg",
                  "categoryDescription": "聚焦新型储能、光伏与深远海风电"
                }
              }
            }
          }
        }
      }
    },
    "/article/create": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章新增",
        "operationId": "articleCreate",
        "parameters": [
          {
            "name": "coverImages",
            "in": "query",
            "required": true,
            "description": "轮播图，多张用 $ 拼接",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "标题",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "作者",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "正文",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishTime",
            "in": "query",
            "required": true,
            "description": "发布时间，格式 yyyy-MM-dd",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-29"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": true,
            "description": "分类 ID，必须是未删除的分类",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回文章 id，失败返回「新增失败：错误信息」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "31"
                }
              }
            }
          }
        }
      }
    },
    "/article/update": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章修改",
        "operationId": "articleUpdate",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "coverImages",
            "in": "query",
            "required": true,
            "description": "轮播图，多张用 $ 拼接",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "标题",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "作者",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "正文",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishTime",
            "in": "query",
            "required": true,
            "description": "发布时间，格式 yyyy-MM-dd",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-29"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": true,
            "description": "分类 ID，必须是未删除的分类",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回文章 id，失败返回「更新失败：错误信息」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "31"
                }
              }
            }
          }
        }
      }
    },
    "/article/delete": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章删除",
        "operationId": "articleDelete",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「成功」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    },
    "/category/list": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "分类列表",
        "operationId": "consoleCategoryList",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleCategoryListVo"
                },
                "example": {
                  "list": [
                    {
                      "categoryId": 1,
                      "name": "清洁能源",
                      "image": "https://a.com/category-1.jpg",
                      "description": "聚焦新型储能、光伏与深远海风电",
                      "createTime": "2026-10-03 05:00:00",
                      "updateTime": "2026-10-03 05:00:00"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/category/info": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "分类详情",
        "operationId": "consoleCategoryInfo",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "required": true,
            "description": "分类 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，时间字段格式为 yyyy-MM-dd HH:mm:ss",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleCategoryInfoVo"
                },
                "example": {
                  "categoryId": 1,
                  "name": "清洁能源",
                  "image": "https://a.com/category-1.jpg",
                  "description": "聚焦新型储能、光伏与深远海风电",
                  "createTime": "2026-10-03 05:00:00",
                  "updateTime": "2026-10-03 05:00:00"
                }
              }
            }
          }
        }
      }
    },
    "/category/create": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "分类新增",
        "operationId": "categoryCreate",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "分类名称",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "image",
            "in": "query",
            "required": true,
            "description": "分类图 URL",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description",
            "in": "query",
            "required": true,
            "description": "分类描述",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回分类 id，失败返回「新增失败：错误信息」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "5"
                }
              }
            }
          }
        }
      }
    },
    "/category/update": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "分类修改",
        "operationId": "categoryUpdate",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "required": true,
            "description": "分类 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "分类名称",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "image",
            "in": "query",
            "required": true,
            "description": "分类图 URL",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description",
            "in": "query",
            "required": true,
            "description": "分类描述",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回分类 id，失败返回「更新失败：错误信息」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "5"
                }
              }
            }
          }
        }
      }
    },
    "/category/delete": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "分类删除",
        "operationId": "categoryDelete",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "required": true,
            "description": "分类 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「成功」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    },
    "/utils/upload": {
      "post": {
        "tags": [
          "console"
        ],
        "summary": "文件上传",
        "operationId": "utilsUpload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "file"
                ],
                "properties": {
                  "type": {
                    "type": "integer",
                    "description": "1 图片、2 视频、3 文件"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "上传的文件"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回文件 url，失败返回「上传失败：错误信息」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "http://localhost:8081/upload/image/2610/31/873_1762000000123_800x600.jpg"
                }
              }
            }
          }
        }
      }
    },
    "/article/export": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章导出",
        "operationId": "articleExport",
        "responses": {
          "200": {
            "description": "xlsx 文件流，不含 id 列",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/article/import": {
      "post": {
        "tags": [
          "console"
        ],
        "summary": "文章导入",
        "operationId": "articleImport",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "xlsx 文件"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "导入成功返回导入条数，失败返回「导入失败：错误信息」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "导入成功：1979"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsoleArticleVo": {
        "type": "object",
        "required": [
          "articleId",
          "wallImage",
          "title",
          "publishTime",
          "createTime",
          "updateTime"
        ],
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int64",
            "description": "文章 ID"
          },
          "wallImage": {
            "type": "string",
            "description": "轮播图第一张"
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "categoryName": {
            "type": "string",
            "description": "分类名称"
          },
          "publishTime": {
            "type": "string",
            "description": "发布时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "createTime": {
            "type": "string",
            "description": "创建时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "updateTime": {
            "type": "string",
            "description": "更新时间，格式 yyyy-MM-dd HH:mm:ss"
          }
        }
      },
      "ConsoleArticleListVo": {
        "type": "object",
        "required": [
          "list",
          "total",
          "pageSize"
        ],
        "properties": {
          "list": {
            "type": "array",
            "description": "文章列表",
            "items": {
              "$ref": "#/components/schemas/ConsoleArticleVo"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "符合关键词的文章总数"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "description": "每页条数"
          }
        }
      },
      "ConsoleArticleInfoVo": {
        "type": "object",
        "required": [
          "articleId",
          "coverImages",
          "title",
          "author",
          "content",
          "publishTime",
          "createTime",
          "updateTime",
          "categoryId",
          "categoryName",
          "categoryImage",
          "categoryDescription"
        ],
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int64",
            "description": "文章 ID"
          },
          "coverImages": {
            "type": "array",
            "description": "轮播图",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "author": {
            "type": "string",
            "description": "作者"
          },
          "content": {
            "type": "string",
            "description": "正文"
          },
          "publishTime": {
            "type": "string",
            "description": "发布时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "createTime": {
            "type": "string",
            "description": "创建时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "updateTime": {
            "type": "string",
            "description": "更新时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "description": "分类 ID"
          },
          "categoryName": {
            "type": "string",
            "description": "分类名称"
          },
          "categoryImage": {
            "type": "string",
            "description": "分类图 URL"
          },
          "categoryDescription": {
            "type": "string",
            "description": "分类描述"
          }
        }
      },
      "ConsoleCategoryVo": {
        "type": "object",
        "required": [
          "categoryId",
          "name",
          "image",
          "description",
          "createTime",
          "updateTime"
        ],
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "description": "分类 ID"
          },
          "name": {
            "type": "string",
            "description": "分类名称"
          },
          "image": {
            "type": "string",
            "description": "分类图 URL"
          },
          "description": {
            "type": "string",
            "description": "分类描述"
          },
          "createTime": {
            "type": "string",
            "description": "创建时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "updateTime": {
            "type": "string",
            "description": "更新时间，格式 yyyy-MM-dd HH:mm:ss"
          }
        }
      },
      "ConsoleCategoryInfoVo": {
        "type": "object",
        "required": [
          "categoryId",
          "name",
          "image",
          "description",
          "createTime",
          "updateTime"
        ],
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "description": "分类 ID"
          },
          "name": {
            "type": "string",
            "description": "分类名称"
          },
          "image": {
            "type": "string",
            "description": "分类图 URL"
          },
          "description": {
            "type": "string",
            "description": "分类描述"
          },
          "createTime": {
            "type": "string",
            "description": "创建时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "updateTime": {
            "type": "string",
            "description": "更新时间，格式 yyyy-MM-dd HH:mm:ss"
          }
        }
      },
      "ConsoleCategoryListVo": {
        "type": "object",
        "required": [
          "list"
        ],
        "properties": {
          "list": {
            "type": "array",
            "description": "分类列表",
            "items": {
              "$ref": "#/components/schemas/ConsoleCategoryVo"
            }
          }
        }
      }
    }
  }
}