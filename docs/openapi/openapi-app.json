{
  "openapi": "3.0.3",
  "info": {
    "title": "NewsFlow APP 接口文档",
    "description": "NewsFlow APP 的接口定义，对应 docs/接口设计文档.md 的 APP 部分。",
    "version": "1.6.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "NEWSFLOW APP"
    }
  ],
  "tags": [
    {
      "name": "app",
      "description": "NEWSFLOW APP，端口 8080"
    }
  ],
  "paths": {
    "/article/list": {
      "get": {
        "tags": [
          "app"
        ],
        "summary": "文章列表",
        "operationId": "articleList",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "description": "页码，从 1 开始",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "标题关键词，非必传",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，isEnd 为 true 表示没有下一页，publishTime 格式为 MM-dd",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleListVo"
                },
                "example": {
                  "list": [
                    {
                      "articleId": 1,
                      "wallImage": {
                        "url": "https://a.com/1.jpg",
                        "ar": 1.33
                      },
                      "title": "示例标题",
                      "categoryName": "清洁能源",
                      "publishTime": "10-29"
                    }
                  ],
                  "isEnd": false
                }
              }
            }
          }
        }
      }
    },
    "/article/info": {
      "get": {
        "tags": [
          "app"
        ],
        "summary": "文章详情",
        "operationId": "articleInfo",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，publishTime 格式为 yyyy-MM-dd",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleInfoVo"
                },
                "example": {
                  "articleId": 1,
                  "coverImages": [
                    "https://a.com/1.jpg",
                    "https://a.com/2.jpg"
                  ],
                  "title": "示例标题",
                  "author": "示例作者",
                  "content": "示例正文",
                  "publishTime": "2026-10-29",
                  "categoryImage": "https://a.com/category-1.jpg",
                  "categoryName": "清洁能源",
                  "categoryDescription": "聚焦新型储能、光伏与深远海风电"
                }
              }
            }
          }
        }
      }
    },
    "/category/list": {
      "get": {
        "tags": [
          "app"
        ],
        "summary": "分类列表",
        "operationId": "appCategoryList",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListVo"
                },
                "example": {
                  "list": [
                    {
                      "categoryId": 1,
                      "name": "清洁能源",
                      "image": "https://a.com/category-1.jpg",
                      "description": "聚焦新型储能、光伏与深远海风电"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArticleVo": {
        "type": "object",
        "required": [
          "articleId",
          "wallImage",
          "title",
          "categoryName",
          "publishTime"
        ],
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int64",
            "description": "文章 ID"
          },
          "wallImage": {
            "type": "object",
            "required": [
              "url",
              "ar"
            ],
            "description": "轮播图第一张",
            "properties": {
              "url": {
                "type": "string",
                "description": "图片地址"
              },
              "ar": {
                "type": "number",
                "format": "float",
                "description": "宽高比，取不到时为 0"
              }
            }
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "categoryName": {
            "type": "string",
            "description": "分类名称"
          },
          "publishTime": {
            "type": "string",
            "description": "发布时间，格式 MM-dd"
          }
        }
      },
      "ArticleListVo": {
        "type": "object",
        "required": [
          "list",
          "isEnd"
        ],
        "properties": {
          "list": {
            "type": "array",
            "description": "文章列表",
            "items": {
              "$ref": "#/components/schemas/ArticleVo"
            }
          },
          "isEnd": {
            "type": "boolean",
            "description": "是否已经没有下一页"
          }
        }
      },
      "ArticleInfoVo": {
        "type": "object",
        "required": [
          "articleId",
          "coverImages",
          "title",
          "author",
          "content",
          "publishTime",
          "categoryImage",
          "categoryName",
          "categoryDescription"
        ],
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int64",
            "description": "文章 ID"
          },
          "coverImages": {
            "type": "array",
            "description": "轮播图",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "author": {
            "type": "string",
            "description": "作者"
          },
          "content": {
            "type": "string",
            "description": "正文"
          },
          "publishTime": {
            "type": "string",
            "description": "发布时间，格式 yyyy-MM-dd"
          },
          "categoryImage": {
            "type": "string",
            "description": "分类图 URL"
          },
          "categoryName": {
            "type": "string",
            "description": "分类名称"
          },
          "categoryDescription": {
            "type": "string",
            "description": "分类描述"
          }
        }
      },
      "CategoryVo": {
        "type": "object",
        "required": [
          "categoryId",
          "name",
          "image",
          "description"
        ],
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "description": "分类 ID"
          },
          "name": {
            "type": "string",
            "description": "分类名称"
          },
          "image": {
            "type": "string",
            "description": "分类图 URL"
          },
          "description": {
            "type": "string",
            "description": "分类描述"
          }
        }
      },
      "CategoryListVo": {
        "type": "object",
        "required": [
          "list"
        ],
        "properties": {
          "list": {
            "type": "array",
            "description": "分类列表",
            "items": {
              "$ref": "#/components/schemas/CategoryVo"
            }
          }
        }
      }
    }
  }
}
