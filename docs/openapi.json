{
  "openapi": "3.0.3",
  "info": {
    "title": "NewsFlow 接口文档",
    "description": "NewsFlow APP 与 CONSOLE 的接口定义，对应 docs/接口设计文档-V1.1.md。",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "NEWSFLOW APP"
    },
    {
      "url": "http://localhost:8081",
      "description": "NEWSFLOW CONSOLE"
    }
  ],
  "tags": [
    {
      "name": "app",
      "description": "NEWSFLOW APP，端口 8080"
    },
    {
      "name": "console",
      "description": "NEWSFLOW CONSOLE，端口 8081"
    }
  ],
  "paths": {
    "/article/list": {
      "servers": [
        {
          "url": "http://localhost:8080"
        }
      ],
      "get": {
        "tags": [
          "app"
        ],
        "summary": "文章列表",
        "operationId": "articleList",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleListVo"
                },
                "example": {
                  "list": [
                    {
                      "articleId": 1,
                      "wallImage": "https://a.com/1.jpg",
                      "title": "示例标题",
                      "publishTime": 1793275200
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/article/info": {
      "servers": [
        {
          "url": "http://localhost:8080"
        }
      ],
      "get": {
        "tags": [
          "app"
        ],
        "summary": "文章详情",
        "operationId": "articleInfo",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleInfoVo"
                },
                "example": {
                  "articleId": 1,
                  "coverImages": [
                    "https://a.com/1.jpg",
                    "https://a.com/2.jpg"
                  ],
                  "title": "示例标题",
                  "author": "示例作者",
                  "content": "示例正文",
                  "publishTime": 1793275200
                }
              }
            }
          }
        }
      }
    },
    "/article/create": {
      "servers": [
        {
          "url": "http://localhost:8081"
        }
      ],
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章新增",
        "operationId": "articleCreate",
        "parameters": [
          {
            "name": "coverImages",
            "in": "query",
            "required": true,
            "description": "轮播图，多张用 $ 拼接",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "标题",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "作者",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "正文",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishTime",
            "in": "query",
            "required": true,
            "description": "发布时间，格式 yyyy-MM-dd",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-29"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「自增id为：xxx」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "自增id为：31"
                }
              }
            }
          }
        }
      }
    },
    "/article/update": {
      "servers": [
        {
          "url": "http://localhost:8081"
        }
      ],
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章修改",
        "operationId": "articleUpdate",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "coverImages",
            "in": "query",
            "required": true,
            "description": "轮播图，多张用 $ 拼接",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "标题",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "作者",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "正文",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishTime",
            "in": "query",
            "required": true,
            "description": "发布时间，格式 yyyy-MM-dd",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-29"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「成功」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    },
    "/article/delete": {
      "servers": [
        {
          "url": "http://localhost:8081"
        }
      ],
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章删除",
        "operationId": "articleDelete",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「成功」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArticleVo": {
        "type": "object",
        "required": [
          "articleId",
          "wallImage",
          "title",
          "publishTime"
        ],
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int64",
            "description": "文章 ID"
          },
          "wallImage": {
            "type": "string",
            "description": "轮播图第一张"
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "publishTime": {
            "type": "integer",
            "format": "int32",
            "description": "发布时间，秒级时间戳"
          }
        }
      },
      "ArticleListVo": {
        "type": "object",
        "required": [
          "list"
        ],
        "properties": {
          "list": {
            "type": "array",
            "description": "文章列表",
            "items": {
              "$ref": "#/components/schemas/ArticleVo"
            }
          }
        }
      },
      "ArticleInfoVo": {
        "type": "object",
        "required": [
          "articleId",
          "coverImages",
          "title",
          "author",
          "content",
          "publishTime"
        ],
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int64",
            "description": "文章 ID"
          },
          "coverImages": {
            "type": "array",
            "description": "轮播图",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "author": {
            "type": "string",
            "description": "作者"
          },
          "content": {
            "type": "string",
            "description": "正文"
          },
          "publishTime": {
            "type": "integer",
            "format": "int32",
            "description": "发布时间，秒级时间戳"
          }
        }
      }
    }
  }
}
