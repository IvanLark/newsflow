{
  "openapi": "3.0.3",
  "info": {
    "title": "NewsFlow CONSOLE 接口文档",
    "description": "NewsFlow CONSOLE 的接口定义，对应 docs/接口文档-V1.2.md 的 CONSOLE 部分。",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "NEWSFLOW CONSOLE"
    }
  ],
  "tags": [
    {
      "name": "console",
      "description": "NEWSFLOW CONSOLE，端口 8081"
    }
  ],
  "paths": {
    "/article/list": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章列表",
        "operationId": "consoleArticleList",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "description": "页码，从 1 开始",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，时间字段格式为 yyyy-MM-dd HH:mm:ss",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleArticleListVo"
                },
                "example": {
                  "list": [
                    {
                      "articleId": 30,
                      "wallImage": "https://a.com/1.jpg",
                      "title": "示例标题",
                      "publishTime": "2026-10-03 06:00:00",
                      "createTime": "2026-10-03 05:00:00",
                      "updateTime": "2026-10-03 05:00:00"
                    }
                  ],
                  "total": 30,
                  "pageSize": 10
                }
              }
            }
          }
        }
      }
    },
    "/article/info": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章详情",
        "operationId": "consoleArticleInfo",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功，时间字段格式为 yyyy-MM-dd HH:mm:ss",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleArticleInfoVo"
                },
                "example": {
                  "articleId": 1,
                  "coverImages": [
                    "https://a.com/1.jpg",
                    "https://a.com/2.jpg"
                  ],
                  "title": "示例标题",
                  "author": "示例作者",
                  "content": "示例正文",
                  "publishTime": "2026-10-29 20:00:00",
                  "createTime": "2026-10-29 19:00:00",
                  "updateTime": "2026-10-29 19:00:00"
                }
              }
            }
          }
        }
      }
    },
    "/article/create": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章新增",
        "operationId": "articleCreate",
        "parameters": [
          {
            "name": "coverImages",
            "in": "query",
            "required": true,
            "description": "轮播图，多张用 $ 拼接",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "标题",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "作者",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "正文",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishTime",
            "in": "query",
            "required": true,
            "description": "发布时间，秒级时间戳",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「自增id为：xxx」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "自增id为：31"
                }
              }
            }
          }
        }
      }
    },
    "/article/update": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章修改",
        "operationId": "articleUpdate",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "coverImages",
            "in": "query",
            "required": true,
            "description": "轮播图，多张用 $ 拼接",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "标题",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "作者",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": true,
            "description": "正文",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishTime",
            "in": "query",
            "required": true,
            "description": "发布时间，秒级时间戳",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「成功」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    },
    "/article/delete": {
      "get": {
        "tags": [
          "console"
        ],
        "summary": "文章删除",
        "operationId": "articleDelete",
        "parameters": [
          {
            "name": "articleId",
            "in": "query",
            "required": true,
            "description": "文章 ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回「成功」，失败返回「失败」",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "成功"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsoleArticleVo": {
        "type": "object",
        "required": [
          "articleId",
          "wallImage",
          "title",
          "publishTime",
          "createTime",
          "updateTime"
        ],
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int64",
            "description": "文章 ID"
          },
          "wallImage": {
            "type": "string",
            "description": "轮播图第一张"
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "publishTime": {
            "type": "string",
            "description": "发布时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "createTime": {
            "type": "string",
            "description": "创建时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "updateTime": {
            "type": "string",
            "description": "更新时间，格式 yyyy-MM-dd HH:mm:ss"
          }
        }
      },
      "ConsoleArticleListVo": {
        "type": "object",
        "required": [
          "list",
          "total",
          "pageSize"
        ],
        "properties": {
          "list": {
            "type": "array",
            "description": "文章列表",
            "items": {
              "$ref": "#/components/schemas/ConsoleArticleVo"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "文章总数"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "description": "每页条数"
          }
        }
      },
      "ConsoleArticleInfoVo": {
        "type": "object",
        "required": [
          "articleId",
          "coverImages",
          "title",
          "author",
          "content",
          "publishTime",
          "createTime",
          "updateTime"
        ],
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int64",
            "description": "文章 ID"
          },
          "coverImages": {
            "type": "array",
            "description": "轮播图",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "author": {
            "type": "string",
            "description": "作者"
          },
          "content": {
            "type": "string",
            "description": "正文"
          },
          "publishTime": {
            "type": "string",
            "description": "发布时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "createTime": {
            "type": "string",
            "description": "创建时间，格式 yyyy-MM-dd HH:mm:ss"
          },
          "updateTime": {
            "type": "string",
            "description": "更新时间，格式 yyyy-MM-dd HH:mm:ss"
          }
        }
      }
    }
  }
}
